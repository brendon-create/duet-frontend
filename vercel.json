{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/s/:slug",
      "destination": "/?utm_source=youtube&utm_medium=shorts&utm_campaign=:slug",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/assets/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ]
}
